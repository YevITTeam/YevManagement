<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>YevUsbAgent</RootNamespace>
    <AssemblyName>YevUsbAgent</AssemblyName>
    <Version>1.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="scripts\install.ps1" LogicalName="install.ps1" />
    <EmbeddedResource Include="scripts\uninstall.ps1" LogicalName="uninstall.ps1" />
    <!-- build.ps1 -ApiKey passes AgentConfig so the exe installs with its server and key preset. -->
    <EmbeddedResource Include="$(AgentConfig)" LogicalName="agent.json" Condition="'$(AgentConfig)' != '' And Exists('$(AgentConfig)')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

</Project>
