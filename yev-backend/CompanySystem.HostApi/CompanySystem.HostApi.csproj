<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- InProcess = xử lý request thẳng trong tiến trình IIS (w3wp.exe), không qua reverse-proxy nội
         bộ tới 1 tiến trình dotnet.exe/Kestrel riêng như OutOfProcess — bớt 1 vòng round-trip loopback
         mỗi request, và tránh vấn đề NTLM/Negotiate phải bắt tay lại do IIS không đảm bảo forward đúng
         1 kết nối Kestrel cho mọi request cùng client (2026-08-11, web.config publish trước đó bị đặt
         nhầm OutOfProcess). Khai rõ ở đây để `dotnet publish` luôn sinh đúng web.config, không phụ
         thuộc việc có ai chỉnh tay lại file publish hay không. -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.9" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Asset.Api\Asset.Api.csproj" />
    <ProjectReference Include="..\Asset.Infrastructure\Asset.Infrastructure.csproj" />
    <ProjectReference Include="..\Attendance.Api\Attendance.Api.csproj" />
    <ProjectReference Include="..\Attendance.Infrastructure\Attendance.Infrastructure.csproj" />
    <ProjectReference Include="..\Identity.Api\Identity.Api.csproj" />
    <ProjectReference Include="..\Indentity.Infrastructure\Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Shared.Infrastructure\Shared.Infrastructure.csproj" />
  </ItemGroup>

</Project>
