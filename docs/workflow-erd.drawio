<mxfile host="app.diagrams.net" agent="YevManagement docs" version="24.7.17">
  <diagram name="Workflow ERD v3" id="workflow-erd">
    <mxGraphModel dx="2200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2380" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="boxIdentity" value="DB: YevIdentityManagement  (GIỮ NGUYÊN — chỉ xác thực + phân quyền, KHÔNG thêm bảng nào)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2FBF2;strokeColor=#82b366;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#4C7A2E;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1820" height="200" as="geometry" />
        </mxCell>
        <mxCell id="boxWorkflow" value="DB: YevWorkflowManagement  (25 bảng — mô hình theo POWER EGG 汎用申請, nền tảng WEB, module ĐỘC LẬP với Attendance)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFF;strokeColor=#6c8ebf;dashed=1;dashPattern=8 8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fontColor=#3A5F8F;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="1820" height="1730" as="geometry" />
        </mxCell>

        <mxCell id="tUsers" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;&lt;i&gt;(đã có — giữ nguyên)&lt;/i&gt;&lt;hr&gt;PK Id : int&lt;br&gt;U&amp;nbsp; UserName : nvarchar(100)&lt;br&gt;· FullName : nvarchar NULL&lt;br&gt;· Email : nvarchar NULL&lt;br&gt;· CreatedAt / DeviceName" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="90" width="280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="tRoles" value="&lt;b&gt;Roles / Permissions&lt;/b&gt;&lt;br&gt;&lt;i&gt;(đã có — giữ nguyên)&lt;/i&gt;&lt;hr&gt;Roles · Permissions&lt;br&gt;UserRoles · RolePermissions&lt;br&gt;UserPermissionOverride&lt;br&gt;&lt;br&gt;&lt;i&gt;→ nạp vào JWT claim&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="410" y="90" width="280" height="135" as="geometry" />
        </mxCell>
        <mxCell id="noteIdentity" value="&lt;b&gt;Phạm vi Identity module&lt;/b&gt;&lt;hr&gt;CHỈ giữ &lt;b&gt;xác thực (Windows AD → JWT)&lt;/b&gt; và &lt;b&gt;phân quyền thô&lt;/b&gt; (vào được module nào, tư cách gì).&lt;br&gt;&lt;b&gt;KHÔNG&lt;/b&gt; chứa cây tổ chức, chức danh, hay bất kỳ luật duyệt nào — toàn bộ nằm ở YevWorkflowManagement.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Điểm chạm duy nhất giữa 2 DB: &lt;b&gt;Employees.UserId&lt;/b&gt; (nullable) và &lt;b&gt;FormAccesses.RoleId&lt;/b&gt;.&lt;/font&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#82b366;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="90" width="700" height="135" as="geometry" />
        </mxCell>

        <mxCell id="tOrgLevels" value="&lt;b&gt;OrgLevels&lt;/b&gt;&lt;br&gt;&lt;i&gt;Danh mục cấp tổ chức&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;U&amp;nbsp; LevelNumber : int&lt;br&gt;· NameVn : nvarchar(100)&lt;br&gt;· NameJp : nvarchar(100) NULL&lt;br&gt;· IsDeleted : bit = 0" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#d5e8d4;strokeColor=#82b366;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="340" width="310" height="135" as="geometry" />
        </mxCell>

        <mxCell id="tOrgUnits" value="&lt;b&gt;OrgUnits&lt;/b&gt;&lt;br&gt;&lt;i&gt;CÂY TỔ CHỨC DÙNG CHUNG (kéo-thả)&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;U&amp;nbsp; Code : nvarchar(50)&lt;br&gt;· NameVn / NameJp : nvarchar(200)&lt;br&gt;FK OrgLevelId → OrgLevels (Restrict)&lt;br&gt;FK ParentId NULL → OrgUnits (self)&lt;br&gt;· SortOrder : int = 0&lt;br&gt;· ValidFrom : datetime2 NULL&lt;br&gt;· ValidTo : datetime2 NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;世代管理 — cơ cấu cũ/mới chạy song song&lt;/i&gt;&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#b85450&quot;&gt;KHÔNG gắn người duyệt ở đây&lt;/font&gt;&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#d5e8d4;strokeColor=#82b366;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="320" width="310" height="225" as="geometry" />
        </mxCell>

        <mxCell id="tJobTitles" value="&lt;b&gt;★ JobTitles&lt;/b&gt;&lt;br&gt;&lt;i&gt;Chức danh 役職 — MỚI&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;U&amp;nbsp; Code : nvarchar(50)&lt;br&gt;· NameVn / NameJp : nvarchar(200)&lt;br&gt;· RankOrder : int&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;thứ bậc — số nhỏ = cao hơn&lt;/i&gt;&lt;br&gt;· IsDeleted : bit = 0" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="310" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tEmployees" value="&lt;b&gt;★ Employees&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nhân sự — điểm neo định danh&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;U&amp;nbsp; EmployeeCode : nvarchar(50)&lt;br&gt;· FullName : nvarchar(200)&lt;br&gt;· FullNameJp : nvarchar(200) NULL&lt;br&gt;· Email : nvarchar(200) NULL&lt;br&gt;· Position : nvarchar(100) NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;mô tả tự do — KHÁC JobTitles&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; (JobTitles mới là thứ dùng cho luồng duyệt)&lt;/i&gt;&lt;br&gt;◇ UserId : int NULL (cross-DB)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;NULL = có trong sơ đồ tổ chức&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; nhưng KHÔNG đăng nhập được&lt;/i&gt;&lt;br&gt;· IsActive : bit = 1 (còn làm việc)&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;UQ filtered (UserId) WHERE NOT NULL&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="320" width="310" height="240" as="geometry" />
        </mxCell>

        <mxCell id="tEmployeeOrgUnits" value="&lt;b&gt;EmployeeOrgUnits&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nhân sự × đơn vị × chức danh (兼務)&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK EmployeeId → Employees (Cascade)&lt;br&gt;FK OrgUnitId → OrgUnits (Restrict)&lt;br&gt;&lt;b&gt;FK JobTitleId NULL → JobTitles&lt;/b&gt; (Restrict)&lt;br&gt;· IsPrimary : bit = 0&lt;br&gt;· ValidFrom / ValidTo : datetime2 NULL&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;UQ (EmployeeId, OrgUnitId, JobTitleId)&lt;/i&gt;&lt;br&gt;&lt;i&gt;1 đơn vị + 1 chức danh = 1 người: validate ở Service&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#d5e8d4;strokeColor=#82b366;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1490" y="320" width="310" height="215" as="geometry" />
        </mxCell>

        <mxCell id="tFormCategories" value="&lt;b&gt;FormCategories&lt;/b&gt;&lt;br&gt;&lt;i&gt;Thư mục form theo phòng ban&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;U&amp;nbsp; Code : nvarchar(50)&lt;br&gt;· NameVn / NameJp : nvarchar(200)&lt;br&gt;FK OrgUnitId NULL → OrgUnits (Restrict)&lt;br&gt;· SortOrder : int = 0&lt;br&gt;· IsDeleted : bit = 0" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="600" width="310" height="150" as="geometry" />
        </mxCell>

        <mxCell id="tFormAccesses" value="&lt;b&gt;FormAccesses&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ai được TẠO đơn form này&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK FormDefinitionId (Cascade)&lt;br&gt;· TargetType : int (Role/OrgUnit/Employee)&lt;br&gt;◇ RoleId : int NULL (cross-DB)&lt;br&gt;FK OrgUnitId NULL (Restrict)&lt;br&gt;FK EmployeeId NULL (Restrict)&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;UQ (FormDefId, TargetType, 3 cột đích)&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="790" width="310" height="180" as="geometry" />
        </mxCell>

        <mxCell id="tFormDefinitions" value="&lt;b&gt;FormDefinitions&lt;/b&gt;&lt;br&gt;&lt;i&gt;1 dòng = 1 loại đơn (申請様式)&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;U&amp;nbsp; Code : nvarchar(50)&lt;br&gt;· NameVn / NameJp : nvarchar(200)&lt;br&gt;FK FormCategoryId (Restrict)&lt;br&gt;· Description : nvarchar(500) NULL&lt;br&gt;· Version : int = 1&lt;br&gt;· IsPublished : bit = 0&lt;br&gt;· AllowAttachment / RequireAttachment&lt;br&gt;· CodePrefix : nvarchar(20)&lt;br&gt;&lt;b&gt;· RouteConditionType : int&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;0=None 1=NumericRange&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; 2=ClassValue 3=Both&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#b85450&quot;&gt;KHÔNG đổi được sau khi tạo&lt;/font&gt;&lt;/i&gt;&lt;br&gt;· RouteNumericFieldKey : nvarchar(50) NULL&lt;br&gt;· RouteClassFieldKey : nvarchar(50) NULL&lt;br&gt;FK CreatedBy/UpdatedByEmployeeId&lt;br&gt;· CreatedAt / UpdatedAt · IsDeleted" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="590" width="310" height="310" as="geometry" />
        </mxCell>

        <mxCell id="tFormRoutes" value="&lt;b&gt;★ FormRoutes&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nhánh duyệt theo điều kiện (ルート判定) — MỚI&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK FormDefinitionId (Cascade)&lt;br&gt;· NameVn / NameJp : nvarchar(200)&lt;br&gt;· SortOrder : int&lt;br&gt;· MinValue : decimal(18,4) NULL&lt;br&gt;· MaxValue : decimal(18,4) NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;数値範囲 — khoảng số&lt;/i&gt;&lt;br&gt;· ClassValue : nvarchar(100) NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;区分値 — giá trị phân loại&lt;/i&gt;&lt;br&gt;· IsDefault : bit = 0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;nhánh dùng khi không khớp gì&lt;/i&gt;&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;UQ filtered (FormDefinitionId) WHERE IsDefault&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="590" width="310" height="245" as="geometry" />
        </mxCell>

        <mxCell id="tFormFields" value="&lt;b&gt;FormFields&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ô nhập của form — designer kéo-thả&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK FormDefinitionId (Cascade)&lt;br&gt;· FieldKey : nvarchar(50)&lt;br&gt;· LabelVn / LabelJp : nvarchar(200)&lt;br&gt;· DataType : int (FieldDataType)&lt;br&gt;· IsRequired : bit = 0&lt;br&gt;· SortOrder : int&lt;br&gt;· ColumnSpan : int = 1 (1..3)&lt;br&gt;· Placeholder / DefaultValue NULL&lt;br&gt;· OptionsJson : nvarchar(max) NULL&lt;br&gt;· MinValue/MaxValue : decimal(18,4)&lt;br&gt;· MaxLength : int NULL&lt;br&gt;· HelpTextVn : nvarchar(500) NULL&lt;br&gt;&lt;b&gt;FK FormDataSourceId NULL&lt;/b&gt; (Restrict)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;外部DB参照 — nguồn dữ liệu ngoài&lt;/i&gt;&lt;br&gt;&lt;b&gt;· AutoNumberPattern : nvarchar(100) NULL&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;自動採番 — vd &quot;PO-{YYYY}-{SEQ:4}&quot;&lt;/i&gt;&lt;br&gt;&lt;b&gt;· DefaultVisible : bit = 1&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;0 = ẩn cho tới khi điều kiện Show khớp&lt;/i&gt;&lt;br&gt;&lt;b&gt;· IsReadOnly : bit = 0&lt;/b&gt;&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;UQ (FormDefinitionId, FieldKey)&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#3A5F8F&quot;&gt;FieldKey ở đây là thứ FormRoutes soi để rẽ nhánh&lt;/font&gt;&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="870" width="310" height="370" as="geometry" />
        </mxCell>

        <mxCell id="tFormApprovalSteps" value="&lt;b&gt;★ FormApprovalSteps&lt;/b&gt;&lt;br&gt;&lt;i&gt;Bước duyệt của MỘT nhánh — 1 dòng = 1 node&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;&lt;b&gt;FK FormRouteId (Cascade)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#b85450&quot;&gt;đổi: trước treo thẳng vào FormDefinitions&lt;/font&gt;&lt;/i&gt;&lt;br&gt;· StepOrder : int&lt;br&gt;· NameVn / NameJp : nvarchar(200)&lt;br&gt;· StepType : int (Approve/Confirm)&lt;br&gt;&lt;b&gt;· OrgUnitScope : int&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;1=Fixed — dùng OrgUnitId bên dưới&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; 2=ApplicantUnit — đơn vị người nộp&lt;/i&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;&lt;font color=&quot;#b85450&quot;&gt;KHÔNG có kiểu tự leo lên cấp trên —&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; Attendance đã thử và loại 2026-08-06&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; (đơn phải qua quá nhiều bước)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;FK OrgUnitId NULL → OrgUnits (Restrict)&lt;br&gt;· ApproverMode : int (Any=OR / All=AND)&lt;br&gt;· RequireSignature : bit = 0&lt;br&gt;· AllowSendBack : bit = 1&lt;br&gt;&lt;b&gt;· AllowAddApprover : bit = 0&lt;/b&gt; &lt;i&gt;承認者の追加&lt;/i&gt;&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;UQ (FormRouteId, StepOrder)&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="590" width="310" height="315" as="geometry" />
        </mxCell>

        <mxCell id="tStepParticipants" value="&lt;b&gt;★ FormApprovalStepParticipants&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ai đứng ở node đó — duyệt hay chỉ xem&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK FormApprovalStepId (Cascade)&lt;br&gt;&lt;b&gt;· ParticipantSource : int&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;1=Employee — chỉ định đích danh&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; 2=JobTitle — chức danh tại node&lt;/i&gt;&lt;br&gt;FK EmployeeId NULL → Employees (Restrict)&lt;br&gt;&lt;b&gt;FK JobTitleId NULL → JobTitles&lt;/b&gt; (Restrict)&lt;br&gt;· ParticipantRole : int&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;1 = Approver&lt;/b&gt; (bấm duyệt được)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;2 = Viewer&lt;/b&gt; (chỉ xem, không thao tác)&lt;br&gt;· SortOrder : int = 0&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;UQ (StepId, EmployeeId, JobTitleId)&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1490" y="590" width="310" height="255" as="geometry" />
        </mxCell>

        <mxCell id="tCategoryCoordinators" value="&lt;b&gt;★ FormCategoryCoordinators&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ai được THIẾT KẾ form của phòng này — MỚI&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK FormCategoryId (Cascade)&lt;br&gt;FK EmployeeId → Employees (Restrict)&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;UQ (FormCategoryId, EmployeeId)&lt;/i&gt;&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#b85450&quot;&gt;CHỈ ĐỊNH TAY — không suy theo chức danh.&lt;br&gt;Attendance đã học: Trưởng phòng thường&lt;br&gt;không tự làm, giao cho người khác phụ trách.&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;i&gt;Khác FormAccesses: đây là ai SỬA được cấu hình,&lt;br&gt;FormAccesses là ai TẠO ĐƠN được.&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="1000" width="310" height="200" as="geometry" />
        </mxCell>

        <mxCell id="tFormDataSources" value="&lt;b&gt;★ FormDataSources&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nguồn dữ liệu cho ô nhập 外部DB参照 — MỚI&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;U&amp;nbsp; Code : nvarchar(50)&lt;br&gt;· NameVn / NameJp : nvarchar(200)&lt;br&gt;· SourceKind : int&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;1=Employees 2=OrgUnits 3=JobTitles&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; 4=SqlQuery (DB ngoài)&lt;/i&gt;&lt;br&gt;· ConnectionName : nvarchar(100) NULL&lt;br&gt;· SqlText : nvarchar(max) NULL&lt;br&gt;· ValueColumn / DisplayColumn : nvarchar(100)&lt;br&gt;· FilterJson : nvarchar(max) NULL&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#b85450&quot;&gt;Admin đăng ký sẵn — designer CHỈ được chọn&lt;br&gt;từ danh sách này, không tự nhập SQL.&lt;br&gt;Service phải ép read-only (chỉ SELECT).&lt;/font&gt;&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="950" width="310" height="260" as="geometry" />
        </mxCell>

        <mxCell id="tFieldConditions" value="&lt;b&gt;★ FormFieldConditions&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ẩn/hiện · bắt buộc theo điều kiện 表示制御 — MỚI&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK TargetFieldId → FormFields (Cascade)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;ô bị điều khiển&lt;/i&gt;&lt;br&gt;FK SourceFieldId → FormFields (Restrict)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;ô mang giá trị điều kiện&lt;/i&gt;&lt;br&gt;· Operator : int&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;Equals / NotEquals / Contains /&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; GreaterThan / LessThan / Between /&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; IsEmpty / IsNotEmpty&lt;/i&gt;&lt;br&gt;· CompareValue : nvarchar(500) NULL&lt;br&gt;· CompareValue2 : nvarchar(500) NULL &lt;i&gt;(Between)&lt;/i&gt;&lt;br&gt;· Effect : int&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;1=Show 2=Hide 3=Require 4=ReadOnly&lt;/b&gt;&lt;br&gt;· LogicGroup : int = 1&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;cùng group = AND, khác group = OR&lt;/i&gt;&lt;br&gt;· SortOrder : int = 0&lt;br&gt;· IsDeleted : bit = 0&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#b85450&quot;&gt;Service phải chặn vòng lặp A→B→A&lt;/font&gt;&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="950" width="310" height="300" as="geometry" />
        </mxCell>

        <mxCell id="tWorkflowRequests" value="&lt;b&gt;WorkflowRequests&lt;/b&gt;&lt;br&gt;&lt;i&gt;BẢNG TRUNG TÂM — đơn&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;U&amp;nbsp; RequestCode : nvarchar(50)&lt;br&gt;FK FormDefinitionId (Restrict)&lt;br&gt;&lt;b&gt;FK FormRouteId NULL (Restrict)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;nhánh đã chọn theo điều kiện lúc nộp&lt;/i&gt;&lt;br&gt;· RouteConditionSnapshot : nvarchar(200) NULL&lt;br&gt;· FormVersion : int&lt;br&gt;★ DataJson : nvarchar(max)&lt;br&gt;★ FormSchemaJson : nvarchar(max)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;NULL khi Draft — chụp lúc nộp&lt;/i&gt;&lt;br&gt;· Status : int (RequestStatus)&lt;br&gt;· CurrentStepOrder : int = 0&lt;br&gt;FK CreatedByEmployeeId (Restrict)&lt;br&gt;FK CreatedByOrgUnitId NULL (Restrict)&lt;br&gt;· CreatedAt / SubmittedAt / CompletedAt&lt;br&gt;· IsDeleted : bit = 0" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="440" y="1290" width="310" height="320" as="geometry" />
        </mxCell>

        <mxCell id="tWorkflowRequestSteps" value="&lt;b&gt;WorkflowRequestSteps&lt;/b&gt;&lt;br&gt;&lt;i&gt;Snapshot luồng duyệt của riêng đơn&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK WorkflowRequestId (Cascade)&lt;br&gt;· StepOrder : int&lt;br&gt;· StepNameSnapshot : nvarchar(200)&lt;br&gt;· StepTypeSnapshot : int&lt;br&gt;· OrgUnitNameSnapshot : nvarchar(200) NULL&lt;br&gt;· ApproverModeSnapshot : int&lt;br&gt;· RequireSignatureSnapshot : bit&lt;br&gt;· AllowSendBackSnapshot : bit&lt;br&gt;· Status : int (StepStatus)&lt;br&gt;&lt;b&gt;· IsAdHoc : bit = 0&lt;/b&gt;&lt;br&gt;&lt;b&gt;FK InsertedByEmployeeId NULL&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;bước thêm giữa chừng 承認者の追加&lt;/i&gt;&lt;br&gt;FK ActedByEmployeeId NULL (Restrict)&lt;br&gt;· ActedAt : datetime2 NULL&lt;br&gt;&lt;i&gt;UQ (WorkflowRequestId, StepOrder)&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="1290" width="310" height="305" as="geometry" />
        </mxCell>

        <mxCell id="tReqStepParticipants" value="&lt;b&gt;★ WorkflowRequestStepParticipants&lt;/b&gt;&lt;br&gt;&lt;i&gt;Snapshot người của node — đã resolve ra NGƯỜI THẬT&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK WorkflowRequestStepId (Cascade)&lt;br&gt;FK EmployeeId → Employees (Restrict)&lt;br&gt;· ParticipantRole : int (Approver/Viewer)&lt;br&gt;· ResolvedFromJobTitle : nvarchar(200) NULL&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;đến từ chức danh nào (nếu có)&lt;/i&gt;&lt;br&gt;· ActedAt : datetime2 NULL&lt;br&gt;&lt;i&gt;IX (EmployeeId) — &quot;Chờ tôi duyệt&quot;&lt;/i&gt;&lt;br&gt;&lt;i&gt;UQ (WorkflowRequestStepId, EmployeeId)&lt;/i&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1290" width="310" height="210" as="geometry" />
        </mxCell>

        <mxCell id="tHistories" value="&lt;b&gt;WorkflowRequestHistories&lt;/b&gt;&lt;br&gt;&lt;i&gt;Audit trail — CHỈ INSERT&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK WorkflowRequestId (Cascade)&lt;br&gt;· StepOrder : int (0 = Submit/Cancel)&lt;br&gt;FK ActorEmployeeId (Restrict)&lt;br&gt;&lt;b&gt;FK OnBehalfOfEmployeeId NULL (Restrict)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;代理承認 — duyệt thay cho ai&lt;/i&gt;&lt;br&gt;· ActorNameSnapshot : nvarchar(200)&lt;br&gt;· Action : int (RequestAction)&lt;br&gt;&lt;b&gt;· SentBackToStepOrder : int NULL&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;i&gt;差戻し có chọn đích&lt;/i&gt;&lt;br&gt;· Comment : nvarchar(1000) NULL&lt;br&gt;· SignatureImage : varbinary(max) NULL&lt;br&gt;· ActionAt : datetime2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1490" y="1290" width="310" height="270" as="geometry" />
        </mxCell>

        <mxCell id="tAttachments" value="&lt;b&gt;WorkflowAttachments&lt;/b&gt;&lt;br&gt;&lt;i&gt;Metadata — file nằm trên đĩa&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK WorkflowRequestId (Cascade)&lt;br&gt;· OriginalFileName : nvarchar(255)&lt;br&gt;· StoredFileName : nvarchar(100) GUID&lt;br&gt;· RelativePath : nvarchar(300)&lt;br&gt;· ContentType : nvarchar(100)&lt;br&gt;· FileSizeBytes : bigint&lt;br&gt;FK UploadedByEmployeeId (Restrict)&lt;br&gt;· UploadedAt : datetime2&lt;br&gt;· IsDeleted : bit = 0" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;" vertex="1" parent="1">
