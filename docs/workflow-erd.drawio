        <mxCell id="tEmailTokens" value="&lt;b&gt;WorkflowRequestEmailTokens&lt;/b&gt;&lt;br&gt;&lt;i&gt;Duyệt qua email — dùng 1 lần&lt;/i&gt;&lt;hr&gt;PK Id : int IDENTITY&lt;br&gt;FK WorkflowRequestId (Cascade)&lt;br&gt;· StepOrder : int&lt;br&gt;FK ApproverEmployeeId (Restrict)&lt;br&gt;U&amp;nbsp; Token : nvarchar(128)&lt;br&gt;· ExpiresAt : datetime2&lt;br&gt;· UsedAt : datetime2 NULL&lt;br&gt;· CreatedAt : datetime2" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontSize=11;fontFamily=Consolas;fillColor=#ffe6cc;strokeColor=#d79b00;spacing=6;" vertex="1" parent="1">
