        <mxCell id="e23" value="FormDataSourceId (Restrict)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;fontSize=10;strokeColor=#3A5F8F;fontColor=#3A5F8F;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="tFormDataSources" target="tFormFields">
