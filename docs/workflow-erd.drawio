        <mxCell id="x1" value="UserId (NULL) · KHÔNG FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;fontColor=#b85450;endArrow=open;endFill=0;fontSize=10;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="tEmployees" target="tUsers">
