<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CompanySystem.HostApi.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- IIS default body limit (~28.6MB) is too small for real .apk files; matches UploadApk's [RequestSizeLimit] (300MB). -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="300000000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>