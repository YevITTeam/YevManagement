<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CompanySystem.HostApi.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="OutOfProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
        </environmentVariables>
      </aspNetCore>
      <!-- Mặc định IIS chặn request body > ~28.6MB (maxAllowedContentLength) — file .apk thật thường
           vượt mốc này. Nâng lên 300MB khớp [RequestSizeLimit] của AppReleaseController.UploadApk
           (asset-module.md §1.23). -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="300000000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>